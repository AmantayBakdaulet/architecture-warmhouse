@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Device Service. Диаграмма компонентов

Container(gateway, "API Gateway", "Kong")
Container(other, "Heating, Lighting, Gate, Video Service", "Go")
ContainerDb(device_db, "Device DB", "PostgreSQL")

Container_Boundary(device_svc, "Device Service") {
  Component(api, "API", "Go, Gin", "REST эндпоинты")
  Component(registry, "Device Registry", "Go", "Список устройств и их статус")
  Component(types, "Device Type Manager", "Go", "Типы устройств и протоколы, в том числе новые")
  Component(registration, "Device Registration", "Go", "Подключение устройства по серийному номеру")
  Component(repo, "Repository", "Go, pgx", "Работа с базой")
}

Rel(gateway, api, "REST")
Rel(other, api, "REST")
Rel(api, registry, "Вызывает")
Rel(api, types, "Вызывает")
Rel(api, registration, "Вызывает")
Rel(registration, types, "Проверяет тип")
Rel(registration, registry, "Добавляет устройство")
Rel(registry, repo, "Использует")
Rel(types, repo, "Использует")
Rel(repo, device_db, "SQL")

SHOW_LEGEND()
@enduml
