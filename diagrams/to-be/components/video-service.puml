@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Video Service. Диаграмма компонентов

Container(gateway, "API Gateway", "Kong")
Container(device_svc, "Device Service", "Go")
System_Ext(cameras, "Камеры")
ContainerDb(video_db, "Video DB", "PostgreSQL")
ContainerDb(video_storage, "Хранилище видео", "S3")

Container_Boundary(video_svc, "Video Service") {
  Component(api, "API", "Go, Gin", "REST эндпоинты")
  Component(camera_manager, "Camera Manager", "Go", "Камеры и их настройки")
  Component(stream, "Stream Receiver", "Go", "Прием видеопотока")
  Component(recorder, "Recorder", "Go", "Запись и выдача видео")
  Component(device_client, "Device Client", "Go", "Запросы в Device Service")
  Component(repo, "Repository", "Go, pgx", "Работа с базой")
}

Rel(gateway, api, "REST")
Rel(api, camera_manager, "Вызывает")
Rel(api, recorder, "Вызывает")
Rel(cameras, stream, "RTSP")
Rel(stream, recorder, "Передает поток")
Rel(camera_manager, device_client, "Проверяет устройство")
Rel(device_client, device_svc, "REST")
Rel(camera_manager, repo, "Использует")
Rel(recorder, repo, "Использует")
Rel(recorder, video_storage, "S3 API")
Rel(repo, video_db, "SQL")

SHOW_LEGEND()
@enduml
